
# Names only. Copy the ones you need into web/.env.local (gitignored). Never commit values.
# Required. A Postgres connection string; run `npm run db:migrate` once against it.
DATABASE_URL=
# Created by `npm run setup`: session signing secret, 32-byte key that seals provider keys and signs the consent
# ledger, and the address people open.
BETTER_AUTH_SECRET=
IZWI_MASTER_KEY=
BETTER_AUTH_URL=http://localhost:3187
IZWI_PUBLIC_URL=http://localhost:3187

# Media storage. Unset keeps files under web/storage. s3 uses a private S3-compatible bucket (for example R2),
# and needs NEXT_PUBLIC_IZWI_UPLOAD=s3 at build time.
IZWI_STORAGE=
NEXT_PUBLIC_IZWI_UPLOAD=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hosted installs: IZWI_HOSTED=1 refuses private provider addresses and writes to unknown hostnames.
# IZWI_TRUST_PROXY=1 only behind a proxy that sets the client address. IZWI_CSP_ENFORCE=1 enforces the CSP.
IZWI_HOSTED=
IZWI_TRUST_PROXY=
IZWI_CSP_ENFORCE=
IZWI_DB_POOL_MAX=

# Assistant spend caps per workspace per day. A paid model needs a cents cap above 0 and IZWI_USD_ZAR below,
# unless the owner marks the provider as a free tier. Local Ollama costs 0.
IZWI_ASSISTANT_DAILY_TOKENS=200000
IZWI_ASSISTANT_DAILY_CENTS=0

# Studio assistant kill switch (Lane C). Set to 1 to turn on "Ask IZWI" and its chat and voice routes; anything else
# hides the panel and makes both routes answer 404. Read by the server on every request: restart to switch, no rebuild.
# Needs a chat provider that has passed its test. The old name NEXT_PUBLIC_IZWI_FLAG_ASSISTANT still works when this is unset.
IZWI_FLAG_ASSISTANT=0
# Settings > Connections (partial): show the guided provider setup. Server-side flag; defaults to off.
IZWI_FLAG_CONNECTIONS=0
# Personal Settings > Preferences. Server-side flag; defaults to off.
IZWI_FLAG_PREFERENCES=0
# Personal Settings > Languages and multilingual greetings. Server-side flag; defaults to off.
IZWI_FLAG_LANGUAGES=0
IZWI_FLAG_SPATIAL_RESTORE=0
IZWI_FLAG_POLICY_PRECHECK=0
IZWI_FLAG_STARTER_TEMPLATES=0
# Transcript injection check. Set it for both the app and the worker. The worker downloads the classifier
# (about 740 MB) into web/storage/models on first use.
IZWI_FLAG_INJECTION=0
IZWI_USD_ZAR=
IZWI_USD_ZAR_ASOF=
