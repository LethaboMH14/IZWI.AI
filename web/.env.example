
# Studio assistant kill switch (Lane C). Set to 1 to turn on "Ask IZWI" and its chat and voice routes; anything else
# hides the panel and makes both routes answer 404. Read by the server on every request: restart to switch, no rebuild.
# Needs a chat provider that has passed its test. The old name NEXT_PUBLIC_IZWI_FLAG_ASSISTANT still works when this is unset.
IZWI_FLAG_ASSISTANT=0
IZWI_FLAG_INJECTION=0
IZWI_USD_ZAR=
IZWI_USD_ZAR_ASOF=
