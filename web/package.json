{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3187",
    "build": "next build",
    "start": "next start --port 3187",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:connections": "playwright test --config playwright.config.ts",
    "setup": "node scripts/setup.mjs && tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx worker/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "test:media": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-test-media.ps1",
    "security": "npm audit --omit=dev && gitleaks dir . --no-banner --redact && semgrep scan --config p/typescript --config p/nextjs --error --quiet src worker",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/react": "4.0.186",
    "@assistant-ui/react": "0.15.38",
    "@assistant-ui/react-ai-sdk": "1.4.25",
    "@aws-sdk/client-s3": "3.1179.0",
    "@aws-sdk/s3-request-presigner": "3.1179.0",
    "@base-ui/react": "1.9.0",
    "@better-auth/passkey": "^1.7.26",
    "@electric-sql/pglite": "0.6.1",
    "@huggingface/transformers": "4.3.2",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "@xyflow/react": "13.0.3",
    "ai": "7.0.181",
    "better-auth": "^1.7.26",
    "better-sqlite3": "^13.2.0",
    "d3-geo": "^3.1.2",
    "fflate": "^0.8.3",
    "libphonenumber-js": "1.13.17",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "tus-js-client": "^4.3.1",
    "uqr": "0.1.3",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true
  }
}
